# .env

# Docker
SERVICE_NAME=website
COMPOSE_PROFILES=local-db

# Database
WORDPRESS_DB_HOST=mariadb
WORDPRESS_DB_USER=root
WORDPRESS_DB_PASSWORD="astrongdatabasepassword"
WORDPRESS_DB_NAME=wordpress_db

# Debug
# WORDPRESS_DEBUG takes 1 or 0 (the string "false" would enable debug); the other two take true or false
WORDPRESS_DEBUG=0
WORDPRESS_DEBUG_LOG=false
WORDPRESS_DEBUG_DISPLAY=false

# Cron
WORDPRESS_DISABLE_CRON=true

# Website
WEBSITE_PROTOCOL=https
WEBSITE_DOMAIN=example.com
WEBSITE_URL=${WEBSITE_PROTOCOL}://${WEBSITE_DOMAIN}
